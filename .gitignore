# OS / editor noise
.DS_Store
*.swp
*.swo

# secrets — never commit
.env
.env.*

# Maintainer's local test harness — kept out of the repo so it doesn't ship in
# user clones. The behavioral eval suite lives in evals/ on the maintainer's
# working copy (run it with the workflow runner), but users cloning Battle Buddy
# don't need it and shouldn't see it. Keep your local evals/ folder; it just
# won't be tracked or pushed.
evals/

# Maintainer's private teaching/marketing kit — video curriculum, recording
# scripts, student handout, and the distribution playbook. Kept local so it
# never ships in a user clone and never goes public. Edit it freely; it just
# won't be tracked or pushed.
teaching/

# Note on privacy: the situation/, mission/, sustainment/, and comms/ files
# ship as BLANK templates and are tracked on purpose so the structure is
# visible when you clone. Once /onboard fills them with your real service
# record, benefits, and people, that copy is YOURS and personal. If you ever
# push your working copy somewhere public, scrub those folders first — or keep
# your working copy private. See "Your data stays yours" in the README.
